{
  "$defs": {
    "ActiveProofReceipt": {
      "additionalProperties": false,
      "properties": {
        "analysis_kind": {
          "$ref": "#/$defs/ContractName"
        },
        "checks_passed": {
          "items": {
            "$ref": "#/$defs/ProofCheck"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Checks Passed",
          "type": "array",
          "uniqueItems": true
        },
        "engine_binding": {
          "$ref": "#/$defs/ProofEngineBinding"
        },
        "proof_profile_id": {
          "$ref": "#/$defs/ProofProfileId"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_binding": {
          "$ref": "#/$defs/ProofSourceBinding"
        },
        "state": {
          "const": "active",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "analysis_kind",
        "schema_version",
        "source_binding",
        "engine_binding",
        "proof_profile_id",
        "checks_passed"
      ],
      "title": "ActiveProofReceipt",
      "type": "object"
    },
    "AnalysisId": {
      "pattern": "^an_[0-9a-f]{32}$",
      "type": "string"
    },
    "AnalysisProvenance": {
      "additionalProperties": false,
      "properties": {
        "code_commit": {
          "$ref": "#/$defs/CodeCommit"
        },
        "dataset_id": {
          "$ref": "#/$defs/DatasetId"
        },
        "engine_name": {
          "$ref": "#/$defs/EngineName"
        },
        "engine_version": {
          "$ref": "#/$defs/EngineVersion"
        },
        "proof_receipts": {
          "items": {
            "$ref": "#/$defs/ActiveProofReceipt"
          },
          "minItems": 1,
          "title": "Proof Receipts",
          "type": "array"
        },
        "source_contract_sha256": {
          "$ref": "#/$defs/Sha256Fingerprint"
        },
        "source_revision": {
          "$ref": "#/$defs/SourceRevision"
        },
        "source_scope": {
          "const": "saxo_openapi",
          "title": "Source Scope",
          "type": "string"
        },
        "source_timestamp": {
          "$ref": "#/$defs/UtcDateTime"
        }
      },
      "required": [
        "dataset_id",
        "source_scope",
        "source_revision",
        "source_contract_sha256",
        "source_timestamp",
        "proof_receipts",
        "engine_name",
        "engine_version",
        "code_commit"
      ],
      "title": "AnalysisProvenance",
      "type": "object"
    },
    "AnalysisRequest": {
      "discriminator": {
        "mapping": {
          "instrument": "#/$defs/InstrumentAnalysisRequest",
          "market": "#/$defs/MarketAnalysisRequest",
          "portfolio": "#/$defs/PortfolioAnalysisRequest"
        },
        "propertyName": "request_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MarketAnalysisRequest"
        },
        {
          "$ref": "#/$defs/InstrumentAnalysisRequest"
        },
        {
          "$ref": "#/$defs/PortfolioAnalysisRequest"
        }
      ]
    },
    "AnalysisResult": {
      "additionalProperties": false,
      "properties": {
        "account_scope": {
          "$ref": "#/$defs/SafeAccountScope"
        },
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "analysis_kind": {
          "$ref": "#/$defs/ContractName"
        },
        "as_of": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/NonEmptyText"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "data_quality": {
          "$ref": "#/$defs/DataQuality"
        },
        "does_not_verify": {
          "items": {
            "$ref": "#/$defs/NonEmptyText"
          },
          "title": "Does Not Verify",
          "type": "array"
        },
        "is_not_advice": {
          "const": true,
          "title": "Is Not Advice",
          "type": "boolean"
        },
        "is_not_forecast": {
          "title": "Is Not Forecast",
          "type": "boolean"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricValue"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "model_distribution_only": {
          "title": "Model Distribution Only",
          "type": "boolean"
        },
        "next_actions": {
          "items": {
            "$ref": "#/$defs/NonEmptyText"
          },
          "title": "Next Actions",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/AnalysisProvenance"
        },
        "replayable": {
          "title": "Replayable",
          "type": "boolean"
        },
        "request": {
          "$ref": "#/$defs/AnalysisRequest"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "verified",
          "default": "verified",
          "title": "Status",
          "type": "string"
        },
        "tool_name": {
          "$ref": "#/$defs/ContractName"
        },
        "valid_until": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "verifies": {
          "items": {
            "$ref": "#/$defs/NonEmptyText"
          },
          "title": "Verifies",
          "type": "array"
        },
        "visibility": {
          "$ref": "#/$defs/VisibilityMode"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/AnalysisWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "visibility",
        "tool_name",
        "analysis_id",
        "analysis_kind",
        "request",
        "account_scope",
        "as_of",
        "valid_until",
        "metrics",
        "warnings",
        "data_quality",
        "provenance",
        "assumptions",
        "is_not_advice",
        "is_not_forecast",
        "model_distribution_only",
        "verifies",
        "does_not_verify",
        "replayable",
        "next_actions"
      ],
      "title": "AnalysisResult",
      "type": "object"
    },
    "AnalysisWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ContractName"
        },
        "message": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "next_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quality_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "AnalysisWarning",
      "type": "object"
    },
    "AnalyticsDegradation": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "analysis_kind": {
          "$ref": "#/$defs/ContractName"
        },
        "as_of": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "dataset_id": {
          "$ref": "#/$defs/DatasetId"
        },
        "does_not_verify": {
          "items": {
            "$ref": "#/$defs/NonEmptyText"
          },
          "title": "Does Not Verify",
          "type": "array"
        },
        "next_action": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "quality": {
          "$ref": "#/$defs/DataQuality"
        },
        "reason": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "reason_code": {
          "$ref": "#/$defs/ContractName"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "degraded",
          "default": "degraded",
          "title": "Status",
          "type": "string"
        },
        "tool_name": {
          "$ref": "#/$defs/ContractName"
        },
        "verifies": {
          "items": {
            "$ref": "#/$defs/NonEmptyText"
          },
          "title": "Verifies",
          "type": "array"
        },
        "visibility": {
          "$ref": "#/$defs/VisibilityMode"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/AnalysisWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "visibility",
        "tool_name",
        "analysis_kind",
        "analysis_id",
        "dataset_id",
        "as_of",
        "reason_code",
        "reason",
        "quality",
        "warnings",
        "next_action",
        "verifies",
        "does_not_verify"
      ],
      "title": "AnalyticsDegradation",
      "type": "object"
    },
    "AnalyticsRefusal": {
      "additionalProperties": false,
      "properties": {
        "analysis_kind": {
          "$ref": "#/$defs/ContractName"
        },
        "as_of": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "does_not_verify": {
          "items": {
            "$ref": "#/$defs/NonEmptyText"
          },
          "title": "Does Not Verify",
          "type": "array"
        },
        "next_action": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "reason": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "reason_code": {
          "$ref": "#/$defs/ContractName"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "refused",
          "default": "refused",
          "title": "Status",
          "type": "string"
        },
        "tool_name": {
          "$ref": "#/$defs/ContractName"
        },
        "verifies": {
          "items": {
            "$ref": "#/$defs/NonEmptyText"
          },
          "title": "Verifies",
          "type": "array"
        },
        "visibility": {
          "$ref": "#/$defs/VisibilityMode"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/AnalysisWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "visibility",
        "tool_name",
        "analysis_kind",
        "as_of",
        "reason_code",
        "reason",
        "next_action",
        "warnings",
        "verifies",
        "does_not_verify"
      ],
      "title": "AnalyticsRefusal",
      "type": "object"
    },
    "ArtifactId": {
      "pattern": "^ar_[0-9a-f]{32}$",
      "type": "string"
    },
    "ArtifactSummary": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_count": {
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "created_at": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "description": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "media_type": {
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/VisibilityMode"
        }
      },
      "required": [
        "visibility",
        "artifact_id",
        "analysis_id",
        "media_type",
        "byte_count",
        "sha256",
        "created_at",
        "description"
      ],
      "title": "ArtifactSummary",
      "type": "object"
    },
    "CodeCommit": {
      "pattern": "^[a-f0-9]{7,64}$",
      "type": "string"
    },
    "ContractName": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]{0,127}$",
      "type": "string"
    },
    "DataCoverage": {
      "additionalProperties": false,
      "properties": {
        "end_at": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "expected_row_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Row Count"
        },
        "missing_row_count": {
          "minimum": 0,
          "title": "Missing Row Count",
          "type": "integer"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "start_at": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "state": {
          "$ref": "#/$defs/QualityState"
        }
      },
      "required": [
        "state",
        "start_at",
        "end_at",
        "row_count",
        "expected_row_count",
        "missing_row_count"
      ],
      "title": "DataCoverage",
      "type": "object"
    },
    "DataQuality": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "coverage": {
          "$ref": "#/$defs/DataCoverage"
        },
        "state": {
          "$ref": "#/$defs/QualityState"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/AnalysisWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "state",
        "coverage",
        "checked_at",
        "warnings"
      ],
      "title": "DataQuality",
      "type": "object"
    },
    "DatasetId": {
      "pattern": "^ds_[0-9a-f]{32}$",
      "type": "string"
    },
    "DatasetSummary": {
      "additionalProperties": false,
      "properties": {
        "account_scope": {
          "$ref": "#/$defs/SafeAccountScope"
        },
        "coverage": {
          "$ref": "#/$defs/DataCoverage"
        },
        "created_at": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "data_quality": {
          "$ref": "#/$defs/DataQuality"
        },
        "dataset_id": {
          "$ref": "#/$defs/DatasetId"
        },
        "fingerprint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fingerprint Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "$ref": "#/$defs/SourceRevision"
        },
        "source_scope": {
          "const": "saxo_openapi",
          "title": "Source Scope",
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/VisibilityMode"
        }
      },
      "required": [
        "visibility",
        "dataset_id",
        "account_scope",
        "source_scope",
        "source_revision",
        "fingerprint_sha256",
        "created_at",
        "coverage",
        "data_quality"
      ],
      "title": "DatasetSummary",
      "type": "object"
    },
    "EngineName": {
      "pattern": "^[a-z][a-z0-9_-]{0,127}$",
      "type": "string"
    },
    "EngineVersion": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "type": "string"
    },
    "InstrumentAnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "analysis_kind": {
          "$ref": "#/$defs/ContractName"
        },
        "dataset_id": {
          "$ref": "#/$defs/DatasetId"
        },
        "instrument_handles": {
          "items": {
            "$ref": "#/$defs/InstrumentHandle"
          },
          "maxItems": 25,
          "minItems": 1,
          "title": "Instrument Handles",
          "type": "array"
        },
        "request_kind": {
          "const": "instrument",
          "title": "Request Kind",
          "type": "string"
        }
      },
      "required": [
        "analysis_kind",
        "dataset_id",
        "request_kind",
        "instrument_handles"
      ],
      "title": "InstrumentAnalysisRequest",
      "type": "object"
    },
    "InstrumentHandle": {
      "pattern": "^ih_[0-9a-f]{32}$",
      "type": "string"
    },
