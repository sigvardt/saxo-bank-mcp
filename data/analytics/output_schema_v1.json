      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "JobSummary": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_ids": {
          "items": {
            "$ref": "#/$defs/ArtifactId"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "created_at": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "message": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyText"
            },
            {
              "type": "null"
            }
          ]
