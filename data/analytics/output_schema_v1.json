    "MarketAnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "analysis_kind": {
          "$ref": "#/$defs/ContractName"
        },
        "dataset_id": {
          "$ref": "#/$defs/DatasetId"
        },
        "request_kind": {
          "const": "market",
          "title": "Request Kind",
          "type": "string"
        }
      },
      "required": [
        "analysis_kind",
        "dataset_id",
        "request_kind"
      ],
      "title": "MarketAnalysisRequest",
      "type": "object"
    },
    "MetricClass": {
      "enum": [
        "broker_reported",
        "calculated_verified",
        "model_output",
        "approximation",
        "unavailable"
      ],
      "title": "MetricClass",
      "type": "string"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoCurrencyCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "metric_class": {
          "$ref": "#/$defs/MetricClass"
        },
        "metric_id": {
          "$ref": "#/$defs/ContractName"
        },
        "proof_profile_id": {
          "$ref": "#/$defs/ProofProfileId"
        },
        "source_timestamp": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "unit": {
          "pattern": "^[a-z][a-z0-9_/%.-]{0,63}$",
          "title": "Unit",
          "type": "string"
        },
        "unit_class": {
          "$ref": "#/$defs/ValueUnitClass"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric_id",
        "value",
        "unit",
        "unit_class",
        "currency",
        "metric_class",
        "source_timestamp",
        "proof_profile_id"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "NonEmptyText": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
    },
    "PortfolioAnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "analysis_kind": {
          "$ref": "#/$defs/ContractName"
        },
        "dataset_id": {
          "$ref": "#/$defs/DatasetId"
        },
        "portfolio_snapshot_id": {
          "$ref": "#/$defs/PortfolioSnapshotId"
        },
        "request_kind": {
          "const": "portfolio",
          "title": "Request Kind",
          "type": "string"
        }
      },
      "required": [
        "analysis_kind",
        "dataset_id",
        "request_kind",
        "portfolio_snapshot_id"
      ],
      "title": "PortfolioAnalysisRequest",
      "type": "object"
    },
    "PortfolioSnapshotId": {
      "pattern": "^ps_[0-9a-f]{32}$",
      "type": "string"
    },
    "ProofCheck": {
      "enum": [
        "golden",
        "property",
        "independent_reference",
        "saxo_reconciliation",
        "sim_end_to_end"
      ],
      "type": "string"
    },
    "ProofEngineBinding": {
      "additionalProperties": false,
      "properties": {
        "code_commit": {
          "$ref": "#/$defs/CodeCommit"
        },
        "engine_name": {
          "$ref": "#/$defs/EngineName"
        },
        "engine_version": {
          "$ref": "#/$defs/EngineVersion"
        }
      },
      "required": [
        "engine_name",
        "engine_version",
        "code_commit"
      ],
      "title": "ProofEngineBinding",
      "type": "object"
    },
    "ProofProfileId": {
      "pattern": "^vp_[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "type": "string"
    },
    "ProofSourceBinding": {
      "additionalProperties": false,
      "properties": {
        "source_contract_sha256": {
          "$ref": "#/$defs/Sha256Fingerprint"
        },
        "source_revision": {
          "$ref": "#/$defs/SourceRevision"
        },
        "source_scope": {
          "const": "saxo_openapi",
          "title": "Source Scope",
          "type": "string"
        }
      },
      "required": [
        "source_scope",
        "source_revision",
        "source_contract_sha256"
      ],
      "title": "ProofSourceBinding",
      "type": "object"
    },
    "QualityState": {
      "enum": [
        "complete",
        "partial",
        "stale",
        "missing",
        "invalid"
      ],
      "title": "QualityState",
      "type": "string"
    },
    "SafeAccountScope": {
      "anyOf": [
        {
          "enum": [
            "aggregate",
            "selected SIM account"
          ],
          "type": "string"
        },
        {
          "pattern": "^aa_[0-9a-f]{12}4[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        }
      ]
    },
    "Sha256Fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "SourceRevision": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "UtcDateTime": {
      "format": "date-time",
      "type": "string"
    },
    "ValueUnitClass": {
      "enum": [
        "monetary",
        "ratio",
        "percentage",
        "count",
        "duration",
        "quantity"
      ],
      "title": "ValueUnitClass",
      "type": "string"
    },
    "VisibilityMode": {
      "enum": [
        "private_user_result",
        "inline_private",
        "local_resource_link",
        "redacted_preview",
        "fingerprint_only",
        "public_evidence"
      ],
      "title": "VisibilityMode",
      "type": "string"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/AnalysisResult"
    },
    {
      "$ref": "#/$defs/DatasetSummary"
    },
    {
      "$ref": "#/$defs/ArtifactSummary"
    },
    {
      "$ref": "#/$defs/JobSummary"
    },
    {
      "$ref": "#/$defs/AnalyticsRefusal"
    },
    {
      "$ref": "#/$defs/AnalyticsDegradation"
    }
  ]
}
