#!/bin/sh
set -eu
umask 077

case $0 in
    */*) launcher_dir=${0%/*} ;;
    *) launcher_dir=. ;;
esac
launcher_dir=$(CDPATH= cd -P -- "$launcher_dir" && pwd -P)
runtime_root=$(CDPATH= cd -P -- "$launcher_dir/.." && pwd -P)
runtime_parent=$(CDPATH= cd -P -- "$runtime_root/.." && pwd -P)
python="$runtime_root/bin/python3.12"
site_packages="$runtime_root/lib/python3.12/site-packages"
run_root="$runtime_parent/.saxo-source-matrix-run.$$"
bootstrap='import os,runpy,stat,sys
runtime,site,root,module=sys.argv[1:5]
del sys.argv[1:5]
names=("coordinator-cache","coordinator-work","coordinator-tmp")
flags=os.O_RDONLY|getattr(os,"O_CLOEXEC",0)|getattr(os,"O_DIRECTORY",0)|getattr(os,"O_NOFOLLOW",0)
parent,root_name=os.path.split(root)
parent_fd=os.open(parent,flags)
root_fd=-1
children=[]
def valid(descriptor):
    metadata=os.fstat(descriptor)
    return stat.S_ISDIR(metadata.st_mode) and metadata.st_uid==os.getuid() and stat.S_IMODE(metadata.st_mode)==0o700
def same(left,right):
    first=os.fstat(left)
    second=os.fstat(right)
    return (first.st_dev,first.st_ino)==(second.st_dev,second.st_ino)
try:
    os.mkdir(root_name,0o700,dir_fd=parent_fd)
    root_fd=os.open(root_name,flags,dir_fd=parent_fd)
    if not valid(root_fd) or os.listdir(root_fd):
        raise SystemExit("unsafe external run directory")
    for name in names:
        os.mkdir(name,0o700,dir_fd=root_fd)
        descriptor=os.open(name,flags,dir_fd=root_fd)
        children.append((name,descriptor))
        if not valid(descriptor) or os.listdir(descriptor):
            raise SystemExit("unsafe external run directory")
    os.environ["TMPDIR"]=os.path.join(root,names[2])
    os.chdir(os.path.join(root,names[1]))
    sys.path.insert(0,site)
    runpy.run_module(module,run_name="__main__",alter_sys=True)
finally:
    cleanup_failed=root_fd<0 or len(children)!=len(names)
    try:
        if not cleanup_failed:
            current=os.open(root_name,flags,dir_fd=parent_fd)
            cleanup_failed=not same(current,root_fd)
            os.close(current)
        if not cleanup_failed and set(os.listdir(root_fd))!=set(names):
            cleanup_failed=True
        if not cleanup_failed:
            for name,descriptor in children:
                if os.listdir(descriptor):
                    cleanup_failed=True
                    break
                current=os.open(name,flags,dir_fd=root_fd)
                changed=not same(current,descriptor)
                os.close(current)
                if changed:
                    cleanup_failed=True
                    break
        if not cleanup_failed:
            for name,_descriptor in reversed(children):
                os.rmdir(name,dir_fd=root_fd)
            if os.listdir(root_fd):
                cleanup_failed=True
        if not cleanup_failed:
            current=os.open(root_name,flags,dir_fd=parent_fd)
            changed=not same(current,root_fd)
            os.close(current)
            if changed:
                cleanup_failed=True
            else:
                os.rmdir(root_name,dir_fd=parent_fd)
    except OSError:
        cleanup_failed=True
    finally:
        for _name,descriptor in reversed(children):
            os.close(descriptor)
        if root_fd>=0:
            os.close(root_fd)
        os.close(parent_fd)
    if cleanup_failed:
        raise SystemExit("external run directory changed or is not empty")'

if [ ! -x "$python" ] || [ ! -d "$site_packages" ]; then
    echo "candidate generation requires its sealed CPython 3.12 runtime" >&2
    exit 1
fi

SAXO_BANK_MCP_OFFICIAL_ISOLATED_LAUNCHER=1
export SAXO_BANK_MCP_OFFICIAL_ISOLATED_LAUNCHER
exec "$python" -I -B -S -X "pycache_prefix=$run_root/coordinator-cache" -c "$bootstrap" \
    "$runtime_root" "$site_packages" "$run_root" \
    saxo_bank_mcp.generate_analytics_source_matrix_candidate "$@"
