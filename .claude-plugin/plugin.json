  "license": "MIT",
  "keywords": [
    "saxo-bank",
    "mcp",
    "openapi",
    "trading"
  ],
  "mcpServers": {
    "saxo-bank-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "run",
        "saxo-bank-mcp",
        "--transport",
        "stdio"
      ]
    }
  }
}
