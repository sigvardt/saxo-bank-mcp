{
  "name": "saxo-bank-mcp",
  "displayName": "Saxo Bank MCP",
  "version": "0.1.0",
  "description": "Saxo Bank OpenAPI MCP server for agent-safe SIM and gated LIVE workflows.",
  "author": {
    "name": "sigvardt",
    "url": "https://github.com/sigvardt"
  },
  "homepage": "https://github.com/sigvardt/saxo-bank-mcp",
